{
  "name": "jonjon1992/php-slim-modular",
  "type": "library",
  "version": "4.0.0",
  "description": "Um framework PHP modular baseado no Slim Framework com suporte completo para AWS, autenticação, criptografia e sistema de módulos",
  "keywords": [
    "slim",
    "framework",
    "modular",
    "aws",
    "s3",
    "sqs",
    "php",
    "api"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "JonJon1992",
      "email": "jonjon1992@example.com"
    }
  ],
  "repositories": [
    {
      "type": "git",
      "name": "jonjon1992/s3-php",
      "url": "https://github.com/JonJon1992/s3-php.git"
    },
    {
      "type": "git",
      "name": "jonjon1992/php-dynamo",
      "url": "https://github.com/JonJon1992/php-dynamo.git"
    }
  ],
  "require": {
    "php": ">= 8.4",
    "ext-fileinfo": "*",
    "ext-json": "*",
    "ext-openssl": "*",
    "ext-redis": "*",
    "ext-sodium": "*",
    "aws/aws-sdk-php": "^3.368",
    "awurth/slim-validation": "5.0.0",
    "guzzlehttp/guzzle": "8.0.1.0",
    "hashids/hashids": "^5.0.2",
    "illuminate/bus": "^10.37.3 || ^11.0 || ^12.0",
    "illuminate/database": "^10.37.3 || ^11.0 || ^12.0",
    "illuminate/events": "^10.37.3 || ^11.0 || ^12.0",
    "illuminate/filesystem": "^10.37.3 || ^11.0 || ^12.0",
    "illuminate/hashing": "^10.37.3 || ^11.0 || ^12.0",
    "illuminate/pagination": "^10.37.3 || ^11.0 || ^12.0",
    "illuminate/queue": "^10.37.3 || ^11.0 || ^12.0",
    "laminas/laminas-hydrator": "4.18.0",
    "lcobucci/clock": "^3.2",
    "lcobucci/jwt": "^5.5",
    "monolog/monolog": "^2.3.2 || ^3.0",
    "nesbot/carbon": "^2.67 || ^3.0",
    "php-di/php-di": "^7.0",
    "predis/predis": "v1.1.6",
    "respect/validation": "^2.0",
    "slim/php-view": "^3.2",
    "slim/psr7": "^1.7",
    "slim/slim": "^4.15.3",
    "symfony/console": "^6.4.1 || ^7.0",
    "symfony/event-dispatcher": "^6.3",
    "vlucas/phpdotenv": "^5.3",
    "jonjon1992/s3-php": "v2.4.0",
    "jonjon1992/php-dynamo": "v3.1.0",
    "nette/mail": "^4.0.4"
  },
  "require-dev": {
    "jangregor/phpstan-prophecy": "1.0.0",
    "overtrue/phplint": "9.0.6",
    "phpspec/prophecy-phpunit": "v2.1.0",
    "phpstan/extension-installer": "1.3.1",
    "phpstan/phpstan": "^1.12",
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "4.0.2.0",
    "symfony/var-dumper": "v7.0.0"
  },
  "autoload": {
    "psr-4": {
      "Core\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "analyse": "phpstan analyse --memory-limit=1G",
    "test": "phpunit"
  },
  "config": {
    "process-timeout": 0,
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "phpstan/extension-installer": false
    }
  }
}
