{
  "name": "jonjon1992/php-slim-modular",
  "type": "library",
  "version": "2.11.6",
  "description": "Um framework PHP modular baseado no Slim Framework com suporte completo para AWS, autenticação, criptografia e sistema de módulos",
  "keywords": [
    "slim",
    "framework",
    "modular",
    "aws",
    "s3",
    "sqs",
    "php",
    "api"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "JonJon1992",
      "email": "jonjon1992@example.com"
    }
  ],
  "repositories": [
    {
      "type": "git",
      "name": "jonjon1992/s3-php",
      "url": "https://github.com/JonJon1992/s3-php.git"
    },
    {
      "type": "git",
      "name": "jonjon1992/php-dynamo",
      "url": "https://github.com/JonJon1992/php-dynamo.git"
    }
  ],
  "require": {
    "php": ">= 8.2",
    "ext-fileinfo": "*",
    "ext-json": "*",
    "ext-openssl": "*",
    "ext-redis": "*",
    "ext-sodium": "*",
    "aws/aws-sdk-php": "3.368.0.0",
    "awurth/slim-validation": "5.0.0",
    "hashids/hashids": "5.0.2",
    "illuminate/bus": "v10.37.3",
    "illuminate/database": "v10.37.3",
    "illuminate/events": "v10.37.3",
    "illuminate/filesystem": "v10.37.3",
    "illuminate/hashing": "v10.37.3",
    "illuminate/pagination": "v10.37.3",
    "illuminate/queue": "v10.37.3",
    "laminas/laminas-hydrator": "4.15.0",
    "lcobucci/jwt": "5.5.0.0",
    "monolog/monolog": "2.3.2",
    "php-di/php-di": "^7.0",
    "predis/predis": "v1.1.6",
    "ramsey/uuid": "4.7.5",
    "slim/php-view": "^3.2",
    "slim/psr7": "^1.7",
    "slim/slim": "^4.9",
    "symfony/console": "v6.4.1",
    "symfony/event-dispatcher": "^6.3",
    "vlucas/phpdotenv": "v5.3.0",
    "jonjon1992/s3-php": "v2.4.0",
    "jonjon1992/php-dynamo": "v3.1.0",
    "nette/mail": "v3.1.11"
  },
  "require-dev": {
    "jangregor/phpstan-prophecy": "1.0.0",
    "overtrue/phplint": "9.0.6",
    "phpspec/prophecy-phpunit": "v2.1.0",
    "phpstan/extension-installer": "1.3.1",
    "phpstan/phpstan": "1.10.50",
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "3.8.0",
    "symfony/var-dumper": "v7.0.0"
  },
  "autoload": {
    "psr-4": {
      "Core\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "config": {
    "process-timeout": 0,
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "phpstan/extension-installer": false
    }
  }
}
